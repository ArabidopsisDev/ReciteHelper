<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../../ReciteHelper.Infrastructure/ReciteHelper.Infrastructure.csproj" />
    <ProjectReference Include="../../ReciteHelper.Wpf/ReciteHelper.Wpf.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Using Include="Xunit" />
    <Content Include="fake-bridge.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tools/pi-bridge/dist/bridge.mjs" Link="pi/bridge.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
