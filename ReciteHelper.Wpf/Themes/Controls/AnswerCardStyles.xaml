<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ReciteHelper.Wpf;component/Themes/Controls/ButtonStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="BaseAnswerCardStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="3,4" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="AnswerCardButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}" />
    <Style x:Key="NotAnsweredCardStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}" />
    <Style x:Key="CorrectAnswerStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}">
        <Setter Property="Background" Value="{DynamicResource ArcSuccessSubtle}" /><Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style x:Key="WrongAnswerStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}">
        <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" /><Setter Property="Foreground" Value="{DynamicResource ArcDanger}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style x:Key="CurrentQuestionStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}">
        <Setter Property="Background" Value="{DynamicResource ArcForeground}" /><Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="CorrectAnswerCardStyle" TargetType="Button" BasedOn="{StaticResource CorrectAnswerStyle}" />
    <Style x:Key="WrongAnswerCardStyle" TargetType="Button" BasedOn="{StaticResource WrongAnswerStyle}" />
    <Style x:Key="CurrentQuestionCardStyle" TargetType="Button" BasedOn="{StaticResource CurrentQuestionStyle}" />
    <Style x:Key="AnsweredCardStyle" TargetType="Button" BasedOn="{StaticResource BaseAnswerCardStyle}">
        <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    </Style>
</ResourceDictionary>
