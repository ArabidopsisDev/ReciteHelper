<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ReciteHelper.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ReciteHelper.Wpf;component/Themes/Arc/ArcTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource ArcReadingFont}" /><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="23" /></Style>
    <Style x:Key="SectionLabelTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}"><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="ReadingTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource ArcReadingFont}" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="FontSize" Value="17" /><Setter Property="LineHeight" Value="29" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="controls:AiAnnotatedAnswer"><Setter Property="FontFamily" Value="{DynamicResource ArcReadingFont}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style x:Key="IconGlyphStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource ArcIconFont}" /><Setter Property="FontSize" Value="20" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" /></Style>
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}"><Setter Property="Margin" Value="16,0,0,8" /><Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" /></Style>
    <Style x:Key="ArcLineIcon" TargetType="Path"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="{DynamicResource ArcTextSecondary}" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
</ResourceDictionary>
