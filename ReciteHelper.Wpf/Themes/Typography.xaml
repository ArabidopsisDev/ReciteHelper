<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TitleTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="21" /></Style>
    <Style x:Key="SectionLabelTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /></Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}"><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="IconGlyphStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource ArcIconFont}" /><Setter Property="FontSize" Value="20" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" /></Style>
</ResourceDictionary>
