        <ResourceDictionary Source="/ReciteHelper.Wpf;component/Themes/Controls/TextBoxStyles.xaml" />
        <ResourceDictionary Source="/ReciteHelper.Wpf;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="RuleReviewButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
