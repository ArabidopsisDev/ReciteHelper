<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource ArcSurface}" /><Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="FontFamily" Value="{StaticResource ArcBodyFont}" /><Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="DefaultWindowStyle" TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
</ResourceDictionary>
