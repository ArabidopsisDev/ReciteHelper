<Window x:Class="ReciteHelper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReciteHelper" Width="1120" Height="740" MinWidth="880" MinHeight="600"
        Closing="Window_Closing" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="RecentItemStyle" TargetType="Button" BasedOn="{StaticResource ListRowButtonStyle}">
            <Setter Property="Padding" Value="16,20" /><Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ArcSurfaceMuted}" Padding="16,28,16,20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Margin="16,0,0,40"><TextBlock Text="ReciteHelper" FontSize="21" FontWeight="Medium" /><TextBlock Text="6.0 Balsamine" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
                    <TextBlock Text="工作区" Style="{StaticResource SidebarLabelStyle}" />
                    <Border Background="{DynamicResource ArcSurface}" CornerRadius="{DynamicResource ArcRadiusNavigation}" Padding="16,13" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcGridIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="我的项目" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Button Click="LoadProject_Click" Style="{StaticResource SidebarButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcFolderIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="打开项目" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Click="OpenFolder_Click" Style="{StaticResource SidebarButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcArrowIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="导入共享项目" VerticalAlignment="Center" /></StackPanel></Button>
                    <TextBlock Text="资源" Style="{StaticResource SidebarLabelStyle}" Margin="16,28,0,8" />
                    <Button Click="ResourceCenter_Click" Style="{StaticResource SidebarButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcCloudIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="资源中心" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Click="ModelSettings_Click" Style="{StaticResource SidebarButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcSettingsIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="模型服务设置" VerticalAlignment="Center" /></StackPanel></Button>
                    <Label x:Name="SloganLabel" Padding="16,18,12,4" FontSize="12" Foreground="{DynamicResource ArcTextMuted}"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20" /></DataTemplate></Label.ContentTemplate></Label>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="40,40,40,24" MaxWidth="880">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="我的项目" Style="{StaticResource TitleTextStyle}" /><TextBlock Text="从上次停下的地方继续。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,16,0" /></StackPanel>
                <Button Grid.Column="1" Click="CreateNewProject_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcPlusIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" Margin="0,0,8,0" /><TextBlock Text="创建项目" /></StackPanel>
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="最近打开" Style="{StaticResource SectionLabelTextStyle}" Margin="16,0,0,16" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentProjectsPanel" /></ScrollViewer>
            <Border Grid.Row="3" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0">
                <TextBlock Text="导入资料或设定范围 → 智能出题 → 练习与考试 → 按掌握情况复习" Style="{StaticResource CaptionTextStyle}" />
            </Border>
        </Grid>
    </Grid>
</Window>
