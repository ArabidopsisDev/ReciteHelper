<Window x:Class="ReciteHelper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReciteHelper" Width="980" Height="660" MinWidth="800" MinHeight="540"
        Closing="Window_Closing" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="RecentItemStyle" TargetType="Button" BasedOn="{StaticResource ListRowButtonStyle}"><Setter Property="Padding" Value="0,14" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="32,28,32,24" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ReciteHelper" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="出题、练习、考试与复习" Style="{StaticResource SubtitleTextStyle}" Margin="0,6,0,0" /></StackPanel>
                <Button Grid.Column="1" Click="ModelSettings_Click" Content="模型服务设置" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
            <Grid Margin="32,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="最近的项目" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,12" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentProjectsPanel" /></ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="1,0,0,0" Padding="24">
                <StackPanel>
                    <TextBlock Text="开始" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,20" />
                    <Button Click="CreateNewProject_Click" Content="创建新项目" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="选择项目类型，导入资料或填写出题范围。" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,24" />
                    <Button Click="LoadProject_Click" Style="{StaticResource ListRowButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconGlyphStyle}" Margin="0,0,12,0" /><TextBlock Text="打开已有项目" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Click="OpenFolder_Click" Style="{StaticResource ListRowButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource IconGlyphStyle}" Margin="0,0,12,0" /><TextBlock Text="导入共享项目" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Click="ResourceCenter_Click" Style="{StaticResource ListRowButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource IconGlyphStyle}" Margin="0,0,12,0" /><TextBlock Text="资源中心" VerticalAlignment="Center" /></StackPanel></Button>
                    <Label x:Name="SloganLabel" Padding="0" Margin="0,32,0,0" FontSize="13" Foreground="{DynamicResource ArcTextMuted}"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Label.ContentTemplate></Label>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="32,12">
            <TextBlock Text="Arabidopsis · ReciteHelper" Style="{StaticResource CaptionTextStyle}" />
        </Border>
    </Grid>
</Window>
