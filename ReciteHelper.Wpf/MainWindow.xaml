<Window
	x:Class="ReciteHelper.Wpf.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ReciteHelper.Wpf.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="ReciteHelper"
	Width="1120"
	Height="740"
	MinWidth="880"
	MinHeight="600"
	Closing="Window_Closing"
	PreviewKeyDown="Workspace_PreviewKeyDown"
	Style="{StaticResource WorkspaceWindowStyle}"
	WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Themes/Home/BalsamineOrnament.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				x:Key="RecentItemStyle"
				BasedOn="{StaticResource WorkspaceRowStyle}"
				TargetType="Button">
				<Setter Property="Padding" Value="12,12" />
				<Setter Property="FontSize" Value="{DynamicResource ArcFontBody}" />
			</Style>
			<Style x:Key="WorkspaceTab" TargetType="TabItem">
				<Setter Property="MaxWidth" Value="236" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TabItem">
							<Border
								x:Name="TabSurface"
								MinHeight="32"
								Margin="0,0,4,0"
								Padding="11,3,4,3"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Background="Transparent"
								BorderBrush="Transparent"
								BorderThickness="1"
								CornerRadius="6">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<ContentPresenter
										x:Name="TabHeader"
										VerticalAlignment="Center"
										ContentSource="Header"
										RecognizesAccessKey="True"
										TextElement.FontWeight="Normal"
										TextElement.Foreground="{DynamicResource ArcTextSecondary}" />
									<Button
										x:Name="CloseTabButton"
										Grid.Column="1"
										Width="24"
										Height="24"
										MinHeight="24"
										Margin="6,0,0,0"
										AutomationProperties.Name="关闭标签页"
										Click="CloseTab_Click"
										Content="×"
										IsTabStop="False"
										Style="{StaticResource IconButtonStyle}"
										ToolTip="关闭标签页" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ArcSurfaceHover}" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ArcSurface}" />
									<Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
									<Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource ArcForeground}" />
									<Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="Medium" />
								</Trigger>
								<Trigger Property="Tag" Value="Home">
									<Setter TargetName="CloseTabButton" Property="Visibility" Value="Collapsed" />
									<Setter TargetName="TabSurface" Property="Padding" Value="11,3" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="WorkspaceTabHeader">
				<TextBlock
					FontSize="{StaticResource ArcFontControl}"
					Text="{Binding}"
					TextTrimming="CharacterEllipsis" />
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>
	<TabControl
		x:Name="WorkspaceTabs"
		ItemContainerStyle="{StaticResource WorkspaceTab}"
		SelectionChanged="WorkspaceTabs_SelectionChanged">
		<TabControl.ItemsPanel>
			<ItemsPanelTemplate>
				<StackPanel Orientation="Horizontal" />
			</ItemsPanelTemplate>
		</TabControl.ItemsPanel>
		<TabControl.Template>
			<ControlTemplate TargetType="TabControl">
				<Grid KeyboardNavigation.TabNavigation="Local">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border
						Background="{DynamicResource ArcSurfaceMuted}"
						BorderBrush="{DynamicResource ArcBorder}"
						BorderThickness="0,0,0,1">
						<Grid MinHeight="44">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ScrollViewer
								x:Name="TabStripScroll"
								Margin="12,0,10,0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Focusable="False"
								HorizontalScrollBarVisibility="Auto"
								VerticalScrollBarVisibility="Disabled">
								<ItemsPresenter />
							</ScrollViewer>
							<controls:WindowTitleBar
								x:Name="WorkspaceTitleBar"
								Grid.Column="1"
								ShowTitle="False" />
						</Grid>
					</Border>
					<ContentPresenter
						x:Name="PART_SelectedContentHost"
						Grid.Row="1"
						ContentSource="SelectedContent" />
				</Grid>
			</ControlTemplate>
		</TabControl.Template>
		<TabItem
			x:Name="HomeTab"
			Header="首页"
			HeaderTemplate="{StaticResource WorkspaceTabHeader}"
			Tag="Home">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="216" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Border
					Padding="12,24,12,16"
					Background="{DynamicResource ArcSurfaceMuted}"
					BorderBrush="{DynamicResource ArcBorder}"
					BorderThickness="0,0,1,0">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<StackPanel>
							<StackPanel Margin="12,0,0,28">
								<TextBlock
									FontFamily="Arial Bold"
									FontSize="24"
									Style="{StaticResource SectionLabelTextStyle}"
									Text="ReciteHelper" />
								<Border Margin="0,4,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock
											Margin="0,3,0,0"
											VerticalAlignment="Center"
											FontFamily="Arial Bold"
											FontSize="16"
											Style="{StaticResource CaptionTextStyle}"
											Text="" />
										<TextBlock
											Margin="0,0,0,0"
											FontFamily="Times New Roman Bold Italic"
											FontSize="20"
											FontStyle="Italic"
											Style="{StaticResource CaptionTextStyle}"
											Text="Balsamine" />
									</StackPanel>
								</Border>

							</StackPanel>
							<TextBlock Style="{StaticResource SidebarLabelStyle}" Text="工作区" />
							<Border
								Margin="0,2"
								Padding="12,8"
								Background="{DynamicResource ArcAccentSubtle}"
								CornerRadius="{DynamicResource ArcRadiusNavigation}">
								<StackPanel Orientation="Horizontal">
									<Path Data="{StaticResource ArcGridIcon}" Style="{StaticResource ArcLineIcon}" />
									<TextBlock
										VerticalAlignment="Center"
										FontSize="{StaticResource ArcFontControl}"
										FontWeight="Medium"
										Text="我的项目" />
								</StackPanel>
							</Border>
							<Button Click="LoadProject_Click" Style="{StaticResource SidebarButtonStyle}">
								<StackPanel Orientation="Horizontal">
									<Path Data="{StaticResource ArcFolderIcon}" Style="{StaticResource ArcLineIcon}" />
									<TextBlock VerticalAlignment="Center" Text="打开项目" />
								</StackPanel>
							</Button>
							<Button Click="OpenFolder_Click" Style="{StaticResource SidebarButtonStyle}">
								<StackPanel Orientation="Horizontal">
									<Path Data="{StaticResource ArcArrowIcon}" Style="{StaticResource ArcLineIcon}" />
									<TextBlock VerticalAlignment="Center" Text="导入共享项目" />
								</StackPanel>
							</Button>
							<TextBlock
								Margin="12,20,0,8"
								Style="{StaticResource SidebarLabelStyle}"
								Text="资源" />
							<Button Click="ResourceCenter_Click" Style="{StaticResource SidebarButtonStyle}">
								<StackPanel Orientation="Horizontal">
									<Path Data="{StaticResource ArcCloudIcon}" Style="{StaticResource ArcLineIcon}" />
									<TextBlock VerticalAlignment="Center" Text="资源中心" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Grid.Row="2">
							<Border
								Margin="0,0,0,8"
								BorderBrush="{DynamicResource ArcBorder}"
								BorderThickness="0,1,0,0" />
							<Button Click="ModelSettings_Click" Style="{StaticResource SidebarButtonStyle}">
								<StackPanel Orientation="Horizontal">
									<Path Data="{StaticResource ArcSettingsIcon}" Style="{StaticResource ArcLineIcon}" />
									<TextBlock VerticalAlignment="Center" Text="模型服务设置" />
								</StackPanel>
							</Button>
							<Label
								x:Name="SloganLabel"
								Padding="16,18,12,4"
								FontSize="12"
								Foreground="{DynamicResource ArcTextMuted}">
								<Label.ContentTemplate>
									<DataTemplate>
										<TextBlock
											LineHeight="20"
											Text="{Binding}"
											TextWrapping="Wrap" />
									</DataTemplate>
								</Label.ContentTemplate>
							</Label>
						</StackPanel>
					</Grid>
				</Border>
				<Grid
					Grid.Column="1"
					MaxWidth="880"
					Margin="36,28,36,24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid Margin="0,0,0,28">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							VerticalAlignment="Center"
							Style="{StaticResource TitleTextStyle}"
							Text="我的项目" />
						<Button
							Grid.Column="1"
							VerticalAlignment="Center"
							Click="CreateNewProject_Click"
							Style="{StaticResource PrimaryButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<Path
									Width="16"
									Height="16"
									Margin="0,0,8,0"
									Data="{StaticResource ArcPlusIcon}"
									Stretch="Uniform"
									Stroke="White"
									StrokeThickness="1.5" />
								<TextBlock Text="创建项目" />
							</StackPanel>
						</Button>
					</Grid>
					<Border
						Grid.Row="1"
						Padding="12,0,12,10"
						BorderBrush="{DynamicResource ArcBorder}"
						BorderThickness="0,0,0,1">
						<TextBlock Style="{StaticResource CaptionTextStyle}" Text="最近打开" />
					</Border>
					<ScrollViewer
						x:Name="RecentProjectsScroll"
						Grid.Row="2"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
						<Grid MinHeight="{Binding ViewportHeight, ElementName=RecentProjectsScroll}">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<StackPanel x:Name="RecentProjectsPanel" />
							<Border
								Grid.Row="1"
								Width="344"
								HorizontalAlignment="Right"
								IsHitTestVisible="False"
								Opacity="0.5">
								<Border.Background>
									<ImageBrush
										AlignmentX="Right"
										AlignmentY="Bottom"
										ImageSource="{StaticResource BalsamineOrnament}"
										Stretch="Uniform" />
								</Border.Background>
							</Border>
						</Grid>
					</ScrollViewer>
				</Grid>
			</Grid>
		</TabItem>
	</TabControl>
</Window>
