<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
		
  </PropertyGroup>

  <PropertyGroup>
    <PiBridgeDirectory>$(MSBuildProjectDirectory)\..\tools\pi-bridge</PiBridgeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PiBridgeSources Include="$(PiBridgeDirectory)\src\**\*.mjs;$(PiBridgeDirectory)\build.mjs;$(PiBridgeDirectory)\package-lock.json;$(PiBridgeDirectory)\PI-LICENSE.txt" />
    <Content Include="$(PiBridgeDirectory)\dist\bridge.mjs" Link="pi\bridge.mjs"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PiBridgeDirectory)\dist\bridge.mjs.LEGAL.txt" Link="pi\bridge.mjs.LEGAL.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PiBridgeDirectory)\dist\THIRD-PARTY-NOTICES.txt" Link="pi\THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RestorePiBridge" Inputs="$(PiBridgeDirectory)\package-lock.json"
          Outputs="$(PiBridgeDirectory)\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(PiBridgeDirectory)" Command="npm ci --ignore-scripts --no-audit --no-fund" />
  </Target>
  <Target Name="BuildPiBridge" BeforeTargets="PrepareForBuild" DependsOnTargets="RestorePiBridge"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'ReciteHelper.Wpf'"
          Inputs="@(PiBridgeSources)" Outputs="$(PiBridgeDirectory)\dist\bridge.mjs;$(PiBridgeDirectory)\dist\bridge.mjs.LEGAL.txt;$(PiBridgeDirectory)\dist\THIRD-PARTY-NOTICES.txt">
    <Exec WorkingDirectory="$(PiBridgeDirectory)" Command="npm run build" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.4" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\AquaAvgFramework\AquaAvgFramework.csproj" />
    <ProjectReference Include="..\ReciteHelper.Application\ReciteHelper.Application.csproj" />
    <ProjectReference Include="..\ReciteHelper.Infrastructure\ReciteHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Images\**\*.png" />
    <Content Include="Images\Phonk\Soundfx\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\Prompts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
