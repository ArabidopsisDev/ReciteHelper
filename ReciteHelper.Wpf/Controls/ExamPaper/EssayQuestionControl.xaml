<UserControl
    x:Class="ReciteHelper.Wpf.Controls.ExamPaper.EssayQuestionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4,0,11">
        <TextBlock
            FontFamily="{DynamicResource ArcReadingFont}"
            FontSize="16"
            LineHeight="24"
            TextWrapping="Wrap">
            <Run x:Name="NumberRun" FontWeight="Normal" />
            <Run x:Name="ScoreRun" FontWeight="Bold" />
            <Run x:Name="QuestionRun" />
        </TextBlock>
        <TextBlock x:Name="PreviewParts" Margin="18,6,0,0" FontFamily="{DynamicResource ArcReadingFont}"
                   FontSize="15" LineHeight="24" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel x:Name="AnswerPanel">
        <Border
            x:Name="AnswerBorder"
            Margin="18,7,0,0"
            Background="#FFFEFB"
            BorderBrush="#AFAFAF"
            BorderThickness="0,0,0,1">
            <TextBox
                x:Name="AnswerTextBox"
                Style="{x:Null}"
                Height="112"
                Padding="4,3"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="{DynamicResource ArcReadingFont}"
                FontSize="16"
                Foreground="#9F1826"
                TextChanged="AnswerTextBox_TextChanged"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
