<UserControl x:Class="ReciteHelper.Wpf.Controls.SubquestionResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="TestPointButton" TargetType="Button">
            <Setter Property="Width" Value="82" /><Setter Property="Height" Value="82" /><Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcFocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Tile" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.85" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.7" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="各小问判分" FontSize="14" FontWeight="Medium" Margin="0,0,0,12" />
        <ItemsControl x:Name="Points">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource TestPointButton}" Background="{Binding Color}" AutomationProperties.Name="{Binding ToolTip}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
                    <Button.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="480" Padding="16"
                                 Background="{DynamicResource ArcSurface}" Foreground="{DynamicResource ArcForeground}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="1">
                            <StackPanel MaxWidth="440">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Detail}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Number}" FontSize="11" />
                        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="21" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="{Binding Coverage}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
