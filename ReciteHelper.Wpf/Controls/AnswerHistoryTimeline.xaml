<UserControl x:Class="ReciteHelper.Wpf.Controls.AnswerHistoryTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Text="作答历史" Style="{StaticResource FieldLabel}" />
            </DockPanel>
            <ScrollViewer x:Name="HistoryScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" PreviewMouseWheel="HistoryScroll_PreviewMouseWheel">
                <Canvas x:Name="Plot" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
