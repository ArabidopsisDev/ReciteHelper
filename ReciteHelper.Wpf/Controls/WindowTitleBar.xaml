<UserControl x:Class="ReciteHelper.Wpf.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="FrameAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource ArcFontCaption}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource ArcSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FrameMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" CornerRadius="5" Background="Transparent" Padding="10,6">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ArcSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid Margin="16,6,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="{DynamicResource ArcFontCaption}" Foreground="{DynamicResource ArcTextMuted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="WindowMenuButton" Click="OpenWindowMenu_Click" AutomationProperties.Name="窗口菜单">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FrameAction}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="NoResize">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="窗口" />
                        <Path Data="M0,0 L3,3 6,0" Stroke="{DynamicResource ArcTextMuted}" StrokeThickness="1.2"
                              Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="WindowMenu" Placement="Bottom" VerticalOffset="4" MinWidth="116"
                                     ItemContainerStyle="{StaticResource FrameMenuItem}"
                                     FontFamily="{DynamicResource ArcBodyFont}" FontSize="{DynamicResource ArcFontControl}">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border CornerRadius="8" Padding="4" Background="{DynamicResource ArcSurface}"
                                            BorderBrush="{DynamicResource ArcBorderStrong}" BorderThickness="1">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <MenuItem x:Name="MinimizeItem" Header="最小化" Click="Minimize_Click" />
                            <MenuItem x:Name="ResizeItem" Header="最大化" Click="Resize_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" Style="{StaticResource FrameAction}"
                        AutomationProperties.Name="关闭窗口" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
