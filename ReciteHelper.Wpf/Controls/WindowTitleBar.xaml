<UserControl x:Class="ReciteHelper.Wpf.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="FrameAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource ArcSurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FrameMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" CornerRadius="5" Background="Transparent" Padding="10,6">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ArcSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="{DynamicResource ArcFontCaption}" Foreground="{DynamicResource ArcTextSecondary}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="WindowMenuButton" Click="OpenWindowMenu_Click" ToolTip="窗口操作" AutomationProperties.Name="窗口操作">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FrameAction}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="NoResize">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" Opacity="0.9">
                        <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource ArcTextSecondary}" />
                        <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource ArcTextSecondary}" Margin="3,0" />
                        <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource ArcTextSecondary}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="WindowMenu" Placement="Bottom" VerticalOffset="4" MinWidth="116"
                                     ItemContainerStyle="{StaticResource FrameMenuItem}"
                                     FontFamily="{DynamicResource ArcBodyFont}" FontSize="{DynamicResource ArcFontControl}">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border CornerRadius="8" Padding="4" Background="{DynamicResource ArcSurface}"
                                            BorderBrush="{DynamicResource ArcBorderStrong}" BorderThickness="1">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <MenuItem x:Name="MinimizeItem" Header="最小化" Click="Minimize_Click" />
                            <MenuItem x:Name="ResizeItem" Header="最大化" Click="Resize_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="CloseButton" Click="Close_Click" Style="{StaticResource FrameAction}"
                        ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Margin="2,0,0,0">
                    <Path Data="M3,3 L11,11 M11,3 L3,11" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource ArcTextSecondary}" StrokeThickness="1.15"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
