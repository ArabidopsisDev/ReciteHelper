<Window x:Class="ReciteHelper.Wpf.Views.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建经典复习项目" Width="760" Height="740" MinWidth="680" MinHeight="640"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,32">
            <StackPanel MaxWidth="640">
                <TextBlock Text="创建经典复习项目" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="导入学习资料，生成知识点与复习题目。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,32" />
                <TextBlock Text="课程名称" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ProjectNameTextBox" TextChanged="ProjectNameTextBox_TextChanged" ToolTip="课程名称将用作项目名称" />
                <TextBlock x:Name="ProjectNameValidation" Foreground="{DynamicResource ArcDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock Text="保存目录" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                <DockPanel><Button x:Name="BrowseStoragePathButton" DockPanel.Dock="Right" Content="选择目录…" Click="BrowseStoragePathButton_Click" Margin="12,0,0,0" /><TextBox x:Name="StoragePathTextBox" IsReadOnly="True" /></DockPanel>
                <TextBlock x:Name="StoragePathValidation" Foreground="{DynamicResource ArcDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock Text="学习资料（PDF、MEG）" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                <DockPanel><Button x:Name="BrowseQuestionBankButton" DockPanel.Dock="Right" Content="添加资料…" Click="BrowseQuestionBankButton_Click" Margin="12,0,0,0" /><TextBox x:Name="QuestionBankTextBox" IsReadOnly="True" /></DockPanel>
                <TextBlock x:Name="QuestionBankValidation" Foreground="{DynamicResource ArcDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock Text="从资料中提取知识点和题目。已有试卷可在创建项目后，通过“导入与导出”导入。" Style="{StaticResource SubtitleTextStyle}" Margin="0,10,0,0" />
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,24,0,0">
                    <StackPanel><TextBlock Text="创建预览" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock x:Name="ProjectPathPreview" Style="{StaticResource SubtitleTextStyle}" Margin="0,12,0,0" /><TextBlock x:Name="QuestionBankPreview" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" /></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="40,20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Label x:Name="ProcessLabel" Content="进度：0/0" Padding="0" FontSize="13" Foreground="{DynamicResource ArcTextSecondary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CountButton" Click="CountButton_Click" Content="估算费用" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" /><Button x:Name="CancelButton" Click="CancelButton_Click" Content="取消" Margin="0,0,8,0" /><Button x:Name="ConfirmButton" Click="ConfirmButton_Click" Content="创建项目" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
