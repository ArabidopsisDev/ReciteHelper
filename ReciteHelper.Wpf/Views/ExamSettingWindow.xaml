<Window x:Class="ReciteHelper.Wpf.Views.ExamSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试设置" Width="1120" Height="850" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"><Setter Property="Width" Value="200" /></Style>
        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SettingTextBoxStyle}"><Setter Property="Width" Value="88" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
        <Style x:Key="WeightSliderStyle" TargetType="Slider" BasedOn="{StaticResource ArcSliderStyle}"><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" /><Setter Property="AutoToolTipPlacement" Value="TopLeft" /><Setter Property="AutoToolTipPrecision" Value="0" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="40,32,40,28"><TextBlock Text="考试设置" Style="{StaticResource TitleTextStyle}" /><TextBlock Text="设置考试时长、题量和抽题范围，也可直接使用已导入的套卷。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,0,40,32">
            <StackPanel MaxWidth="1040">
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="LoadExamSetCheckBox" Content="使用已导入的套卷" IsEnabled="False" Checked="LoadExamSetCheckBox_Changed" Unchecked="LoadExamSetCheckBox_Changed" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ExamSetComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" IsEnabled="False" SelectionChanged="ExamSetComboBox_SelectionChanged" />
                </Grid>
                <Grid x:Name="DefaultPaperSettingsPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="基本设置" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,24" />
                        <TextBlock Text="课程号" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CourseNumberTextBox" Text="XF114514" HorizontalAlignment="Left" Style="{StaticResource SettingTextBoxStyle}" />
                        <TextBlock Text="考试时间（分钟）" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExamTimeTextBox" Text="60" Style="{StaticResource NumericTextBoxStyle}" />
                            <Slider x:Name="ExamTimeSlider" Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource ArcSliderStyle}" VerticalAlignment="Center" Minimum="10" Maximum="180" TickFrequency="10" AutoToolTipPlacement="TopLeft" ValueChanged="ExamTimeSlider_ValueChanged" Value="60" />
                        </Grid>
                        <TextBlock Text="可设置 10–180 分钟。" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="考试题量（道）" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="QuestionCountTextBox" Text="20" Style="{StaticResource NumericTextBoxStyle}" />
                            <Slider x:Name="QuestionCountSlider" Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource ArcSliderStyle}" VerticalAlignment="Center" Minimum="5" Maximum="100" TickFrequency="10" AutoToolTipPlacement="TopLeft" ValueChanged="QuestionCountSlider_ValueChanged" Value="20" />
                        </Grid>
                        <TextBlock Text="选择题 3 分，填空每空 1 分，判断题 1 分，名词解释 4 分，解答题 5 分。" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" />
                        <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,28,0,0">
                            <StackPanel><TextBlock Text="试卷预览" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,12" />
                                <Label x:Name="TotalTimePreview" Padding="0,4" Foreground="{DynamicResource ArcTextSecondary}" FontSize="14" />
                                <Label x:Name="QuestionCountPreview" Padding="0,4" Foreground="{DynamicResource ArcTextSecondary}" FontSize="14" />
                                <Label x:Name="ScorePerQuestionPreview" Padding="0,4" Foreground="{DynamicResource ArcTextSecondary}" FontSize="14" />
                                <Label x:Name="TotalScorePreview" Padding="0,4" FontWeight="Medium" FontSize="14" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="PresetExamButton" Content="按掌握情况组卷 ⌄" Click="PresetExamButton_Click" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <Button.ContextMenu><ContextMenu x:Name="PresetMenu"><MenuItem Click="WeakestPointExam_Click" Header="最弱点组卷" /><MenuItem Click="BalancedWeaknessExam_Click" Header="弱点均衡组卷" /></ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,16"><TextBlock Text="章节权重" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" /><Button x:Name="ResetWeightsButton" Content="重置" Click="ResetWeightsButton_Click" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="全部设为 0 时，从所有题目随机抽取。指定权重后，按各章比例抽题；权重之和无需等于 100%。" Style="{StaticResource SubtitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,8"><TextBlock Text="当前权重总和  " Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="TotalWeightText" Text="0%" FontSize="12" FontWeight="Medium" /></StackPanel>
                        <ItemsControl x:Name="ChapterWeightsItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1" Padding="0,20">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding ChapterName}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding QuestionCount, StringFormat={}{0} 道题目}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="WeightTextBox" Width="72" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" TextChanged="WeightTextBox_TextChanged" Style="{StaticResource NumericTextBoxStyle}" /><TextBlock Text="%" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
                                    </Grid>
                                    <Slider Margin="0,16,0,0" Style="{StaticResource WeightSliderStyle}" ValueChanged="WeightSlider_ValueChanged" Value="{Binding Weight}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border x:Name="NoChaptersPanel" Visibility="Collapsed" Padding="0,28"><StackPanel><TextBlock Text="暂无章节" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock Text="先在项目中添加章节。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="40,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" Margin="0,0,8,0" /><Button x:Name="SaveButton" Content="保存设置" Click="SaveButton_Click" Margin="0,0,8,0" /><Button x:Name="StartExamButton" Content="开始考试" Click="StartExamButton_Click" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
        </Border>
    </Grid>
</Window>
