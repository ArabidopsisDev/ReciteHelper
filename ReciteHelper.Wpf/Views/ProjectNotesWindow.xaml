<Window x:Class="ReciteHelper.Wpf.Views.ProjectNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Grid Background="{DynamicResource ArcSurfaceMuted}" Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBox x:Name="NotesTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="{DynamicResource ArcReadingFont}"
                 AutomationProperties.Name="项目笔记" />
        <TextBlock x:Name="SaveStatus" Grid.Row="1" Margin="0,10,0,0" Text="自动保存"
                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
