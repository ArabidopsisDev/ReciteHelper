<Window
    x:Class="ReciteHelper.Wpf.Views.WrongQuestionImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="导入错题"
    Width="920"
    Height="680"
    Style="{StaticResource AppWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="40,28" Background="White" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="Medium" Foreground="{DynamicResource ArcForeground}" Text="将错题导入项目" />
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,8,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource ArcTextSecondary}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="40,16" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CandidatesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="0,20"
                            Background="White"
                            BorderBrush="{DynamicResource ArcBorder}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,3,16,0"
                                    VerticalAlignment="Top"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource ArcForeground}"
                                        Text="{Binding Number, StringFormat='第{0}题'}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Foreground="#1E293B"
                                        LineHeight="22"
                                        Text="{Binding Question.Text}"
                                        FontFamily="{DynamicResource ArcReadingFont}"
                                        TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="Transparent" CornerRadius="0">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ArcTextSecondary}" Text="你的答案" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#334155" Text="{Binding UserAnswer}" Style="{StaticResource ReadingTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" Background="Transparent" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="Medium" Foreground="#15803D" Text="正确答案" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#166534" Text="{Binding CorrectAnswer}" Style="{StaticResource ReadingTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="12"
                                        Foreground="#B45309"
                                        Text="{Binding DuplicateHint}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasSimilarQuestion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,16" Background="White" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Click="SelectAllButton_Click" Content="全选" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="12,0,0,0" Click="ClearSelectionButton_Click" Content="全不选" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="12,0,0,0" Click="ConfirmButton_Click" Content="确认导入" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
