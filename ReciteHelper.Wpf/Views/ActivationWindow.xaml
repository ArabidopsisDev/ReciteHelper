<Window x:Class="ReciteHelper.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型服务设置" Width="1040" Height="800" MinWidth="880" MinHeight="660"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ArcSurfaceMuted}" Padding="8,36,8,24">
            <StackPanel>
                <TextBlock Text="设置" FontSize="21" FontWeight="Medium" Margin="24,0,0,36" />
                <TextBlock Text="模型服务" Style="{StaticResource SidebarLabelStyle}" Margin="24,0,0,8" />
                <ListBox x:Name="SettingsNavigation" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItemStyle}">
                    <ListBoxItem Content="当前模型" Tag="CurrentModelSection" />
                    <ListBoxItem Content="账号授权" Tag="OAuthSection" />
                    <ListBoxItem Content="DeepSeek 与 Qwen" Tag="DeepSeekSection" />
                    <ListBoxItem Content="OpenRouter" Tag="OpenRouterSection" />
                    <ListBoxItem Content="托管服务" Tag="HostedSection" />
                </ListBox>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,36,40,32">
                <StackPanel MaxWidth="760">
                    <TextBlock Text="模型服务" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="为出题、批改和答题解析选择模型。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,36" />
                    <StackPanel x:Name="CurrentModelSection">
                        <TextBlock Text="当前模型" Style="{StaticResource SectionLabelTextStyle}" />
                        <TextBlock x:Name="ModelSelectionHintText" Text="列表显示已接入的服务，包括环境变量中的配置。切换后，其他服务的配置仍会保留。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,16" />
                        <ComboBox x:Name="ActiveModelBox" DisplayMemberPath="Name" SelectedValuePath="Mode" AutomationProperties.Name="当前使用的模型" />
                        <Button x:Name="UseSelectedModelButton" Content="使用所选模型" Click="UseSelectedModel_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,32" />
                    <StackPanel x:Name="OAuthSection">
                        <TextBlock Text="账号授权" Style="{StaticResource SectionLabelTextStyle}" />
                        <TextBlock Text="登录已有模型账号，选择该账号可用的模型。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,16" />
                        <Button Content="管理账号与模型" Click="PiOAuthButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,32,0,24" />
                    <Expander x:Name="DeepSeekSection" Header="DeepSeek 与 Qwen">
                        <StackPanel Margin="0,20,0,8">
                            <TextBlock Text="DeepSeek 用于文本生成与批改。建立资料知识库时，另需 Qwen 向量服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,20" />
                            <TextBlock Text="DeepSeek API Key" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="DeepSeekKeyBox" AutomationProperties.Name="DeepSeek API Key" />
                            <TextBlock Text="Qwen API Key（建立知识库时需要）" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
                            <PasswordBox x:Name="QwenKeyBox" AutomationProperties.Name="Qwen API Key" />
                            <TextBlock Text="也可设置 DEEPSEEK_API_KEY 和 QWEN_API_KEY 环境变量。" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,20" />
                            <Button Content="保存并使用 DeepSeek" Click="SaveDirectKeysButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,24" />
                    <Expander x:Name="OpenRouterSection" Header="OpenRouter">
                        <StackPanel Margin="0,20,0,8">
                            <TextBlock Text="通过 OpenRouter 接入文本与向量模型，具体模型名称可在高级配置中修改。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,20" />
                            <TextBlock Text="OpenRouter API Key" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="OpenRouterKeyBox" AutomationProperties.Name="OpenRouter API Key" />
                            <Button Content="保存并使用 OpenRouter" Click="SaveOpenRouterButton_Click" HorizontalAlignment="Left" Margin="0,16,0,0" />
                        </StackPanel>
                    </Expander>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,24" />
                    <Expander x:Name="HostedSection" Header="ReciteHelper 托管服务">
                        <StackPanel Margin="0,20,0,8">
                            <TextBlock Text="输入激活码，由 ReciteHelper 服务器提供模型服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,20" />
                            <TextBlock Text="激活码" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ActivationCodeTextBox" CharacterCasing="Upper" />
                            <Button x:Name="ActivateButton" Content="验证并激活" Click="ActivateButton_Click" HorizontalAlignment="Left" Margin="0,16,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Padding="40,20" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText" Text="手动填写的 API Key 保存在本机 Config.xml 中。" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />
                    <Grid Grid.Row="1"><Button Click="OpenConfigButton_Click" Content="高级配置" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" /><Button Click="ExitButton_Click" Content="完成" HorizontalAlignment="Right" MinWidth="88" /></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
