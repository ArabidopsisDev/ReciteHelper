<Window x:Class="ReciteHelper.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型服务设置" Width="960" Height="780" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="32,24" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="模型服务" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="选择后续出题、批改和答题解析使用的模型。" Margin="0,6,0,0" Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24">
                <TextBlock Text="当前使用的模型" Style="{StaticResource SectionLabelTextStyle}" />
                <DockPanel Margin="0,12,0,8">
                    <Button x:Name="UseSelectedModelButton" DockPanel.Dock="Right" Margin="12,0,0,0" Content="使用所选模型" Click="UseSelectedModel_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    <ComboBox x:Name="ActiveModelBox" DisplayMemberPath="Name" SelectedValuePath="Mode" AutomationProperties.Name="当前使用的模型" />
                </DockPanel>
                <TextBlock Text="列表显示已接入的服务，包括从环境变量读取的配置。切换服务会保留其他服务的配置。" Style="{StaticResource SubtitleTextStyle}" />
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                <TextBlock Text="接入与配置" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,8" />
                <Grid Margin="0,12,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="模型账号授权（OAuth）" FontWeight="SemiBold" /><TextBlock Text="登录已有模型账号，选择该账号可用的模型。" Style="{StaticResource SubtitleTextStyle}" Margin="0,6,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="管理账号与模型…" Click="PiOAuthButton_Click" VerticalAlignment="Center" />
                </Grid>
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" />
                <Expander x:Name="DeepSeekSection" Header="DeepSeek 与 Qwen" Margin="0,16">
                    <StackPanel Margin="20,14,0,0">
                        <TextBlock Text="DeepSeek 用于文本生成与批改。建立资料知识库时，另外使用 Qwen 向量服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="DeepSeek API Key" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="DeepSeekKeyBox" AutomationProperties.Name="DeepSeek API Key" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Qwen API Key（建立知识库时需要）" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="QwenKeyBox" AutomationProperties.Name="Qwen API Key" /></StackPanel>
                        </Grid>
                        <TextBlock Text="也可设置 DEEPSEEK_API_KEY 和 QWEN_API_KEY 环境变量。" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,12" />
                        <Button Content="保存并使用 DeepSeek" Click="SaveDirectKeysButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" />
                <Expander Header="OpenRouter" Margin="0,16">
                    <StackPanel Margin="20,14,0,0">
                        <TextBlock Text="通过 OpenRouter 接入文本与向量模型，具体模型名称可在高级配置中修改。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="OpenRouter API Key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="OpenRouterKeyBox" AutomationProperties.Name="OpenRouter API Key" />
                        <Button Content="保存并使用 OpenRouter" Click="SaveOpenRouterButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Expander>
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" />
                <Expander Header="ReciteHelper 托管服务" Margin="0,16">
                    <StackPanel Margin="20,14,0,0">
                        <TextBlock Text="输入激活码，由 ReciteHelper 服务器提供模型服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="激活码" Style="{StaticResource FieldLabel}" />
                        <DockPanel><Button x:Name="ActivateButton" DockPanel.Dock="Right" Content="验证并激活" Click="ActivateButton_Click" Margin="12,0,0,0" /><TextBox x:Name="ActivationCodeTextBox" CharacterCasing="Upper" /></DockPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="32,16" Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="手动填写的 API Key 保存在本机 Config.xml 中。" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Button Grid.Column="1" Click="OpenConfigButton_Click" Content="高级配置" />
                <Button Grid.Column="2" Click="ExitButton_Click" Content="关闭" Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
