<Window x:Class="ReciteHelper.Wpf.Views.FileMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件合并" Width="1100" Height="780" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="40,32,40,28"><TextBlock Text="文件合并" Style="{StaticResource TitleTextStyle}" /><TextBlock Text="合并 DOCX、PPTX、PDF、MEG、TXT 等资料，供创建项目使用。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="40,0,40,24"><Button x:Name="ModeButton" Click="ModeButton_Click" Content="模式：Sequential" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" /><Button Content="添加文件" Click="AddFilesButton_Click" HorizontalAlignment="Right" /></Grid>
        <Grid Grid.Row="2" Margin="40,0,40,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FilesItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,20">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" FontSize="13" Foreground="{DynamicResource ArcTextMuted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding FileExtension}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding FileSize}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding LastModified}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Content="移除" Click="RemoveFileButton_Click" Tag="{Binding FilePath}" Style="{StaticResource SubtleButtonStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <Border x:Name="EmptyStatePanel" Background="{DynamicResource ArcSurface}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="还没有添加文件" Style="{StaticResource SectionLabelTextStyle}" HorizontalAlignment="Center" /><TextBlock Text="选择需要合并的资料后，点击开始合并。" Style="{StaticResource SubtitleTextStyle}" Margin="0,10,0,0" /></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="40,20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FilesCountText" Text="已添加 0 个文件" FontSize="14" /><TextBlock x:Name="TotalSizeText" Text="总大小：0 KB" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ClearAllButton" Click="ClearAllButton_Click" Content="清空列表" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="MergeButton" Click="MergeButton_Click" Content="开始合并" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
