<Window x:Class="ReciteHelper.Wpf.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用程序异常" Width="800" Height="720" MinWidth="640" MinHeight="560"
        Closing="Window_Closing" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="40,32,40,24"><TextBlock Text="应用程序异常" Style="{StaticResource TitleTextStyle}" /><TextBlock Text="操作未能完成。可复制下方信息，供排查问题使用。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="40,0,40,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding ExceptionType}" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource ArcDanger}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{Binding ExceptionMessage}" Style="{StaticResource SubtitleTextStyle}" Margin="0,10,0,24" />
            <TextBox x:Name="ExceptionDetailsBox" Grid.Row="2" Text="{Binding ExceptionDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="16" FontFamily="Consolas, Courier New" FontSize="12" />
            <TextBlock Grid.Row="3" Text="详细信息已保存至 error.log。" Style="{StaticResource CaptionTextStyle}" Margin="0,16,0,0" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="40,20">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="CloseButton" Click="CloseButton_Click" Content="关闭" Margin="0,0,8,0" /><Button x:Name="CopyButton" Click="CopyButton_Click" Content="复制信息" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
        </Border>
    </Grid>
</Window>
