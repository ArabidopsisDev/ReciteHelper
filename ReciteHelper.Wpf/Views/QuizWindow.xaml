<Window x:Class="ReciteHelper.Wpf.Views.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReciteHelper.Wpf.Controls"
        Title="答题窗口 - ReciteHelper" Width="1120" Height="700" MinWidth="920" MinHeight="560"
        Closing="Window_Closing" Icon="/Images/project.png" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HelpSidebarColumn" Width="0" /></Grid.ColumnDefinitions>
        <Image Name="PhonkImage" Grid.ColumnSpan="3" Width="256" Height="256" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1000" IsHitTestVisible="False">
            <Image.RenderTransform><TranslateTransform x:Name="ImageTranslate" X="0" Y="0" /></Image.RenderTransform>
        </Image>
        <MediaElement Name="PhonkPlayer" Width="0" Height="0" LoadedBehavior="Manual" UnloadedBehavior="Manual" />
        <Border Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="20,24,20,16"><TextBlock Text="答题卡" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock Text="选择题号切换题目" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
                <ScrollViewer Grid.Row="1" Padding="12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AnswerCardItemsControl">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Click="SwitchButton_Click" CommandParameter="{Binding Number}" Content="{Binding Number}" Style="{Binding StatusStyle}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="20,16"><TextBlock x:Name="StatsTextBlock" Style="{StaticResource CaptionTextStyle}" /></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Padding="28,16" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="180" Margin="0,6,0,6">
                        <TextBlock Text="第 " Foreground="{DynamicResource ArcTextSecondary}" /><TextBlock x:Name="CurrentQuestionText" Text="1" FontWeight="SemiBold" />
                        <TextBlock Text=" 题 / 共 " Foreground="{DynamicResource ArcTextSecondary}" /><TextBlock x:Name="TotalQuestionsText" Text="20" /><TextBlock Text=" 题" Foreground="{DynamicResource ArcTextSecondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ClearButton" Click="ClearButton_Click" Content="清空记录" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,16,0" />
                        <Button x:Name="PrevButton" Click="PrevButton_Click" Content="上一题" Margin="0,0,8,0" />
                        <Button x:Name="NextButton" Click="NextButton_Click" Content="下一题" />
                    </StackPanel>
                </WrapPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                <StackPanel>
                    <Grid Margin="0,0,0,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="QuestionTextBlock" FontSize="17" LineHeight="29" TextWrapping="Wrap" />
                        <Label Name="QDisplayLabel" Grid.Row="1" HorizontalAlignment="Right" Padding="0" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ArcTextMuted}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AnswerPromptText" Text="请输入答案：" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <TextBox x:Name="AnswerTextBox" MinHeight="120" Style="{StaticResource QuizTextBoxStyle}" TextChanged="AnswerTextBox_TextChanged" />
                            <Border x:Name="InlineAnswerFeedbackBorder" MinHeight="120" MaxHeight="300" Padding="12" Background="{DynamicResource ArcSurface}" BorderBrush="{DynamicResource ArcBorderStrong}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><controls:AiAnnotatedAnswer x:Name="InlineAnswerFeedback" FontSize="16" LineHeight="28" TextWrapping="Wrap" /></ScrollViewer>
                            </Border>
                            <Expander x:Name="AiReferenceExpander" Header="查看参考答案" Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource ArcTextSecondary}" Visibility="Collapsed">
                                <TextBlock x:Name="AiReferenceText" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24" />
                            </Expander>
                            <ItemsControl x:Name="FillBlankAnswersItemsControl" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,20,12" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number, StringFormat=第{0}空}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ArcTextSecondary}" />
                                    <TextBox Width="190" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="ChoiceOptionsItemsControl" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton Checked="ChoiceOption_Checked" Content="{Binding DisplayText}" GroupName="QuizChoiceOptions" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="{Binding Id}" />
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <StackPanel x:Name="TrueFalseOptionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <RadioButton x:Name="TrueOptionRadioButton" Margin="0,0,16,0" Checked="TrueFalseOption_Checked" Content="正确" GroupName="QuizTrueFalseOptions" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="正确" />
                                <RadioButton x:Name="FalseOptionRadioButton" Checked="TrueFalseOption_Checked" Content="错误" GroupName="QuizTrueFalseOptions" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="错误" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ResultArea" Margin="0,20,0,0" Padding="16" BorderThickness="1" Visibility="Collapsed">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="ResultTitleText" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="您的答案" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="UserAnswerText" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,12" />
                                <TextBlock Text="参考答案" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="CorrectAnswerText" TextWrapping="Wrap" LineHeight="24" />
                            </StackPanel>
                            <Button x:Name="QuestionHelpButton" Grid.Column="1" Click="QuestionHelpButton_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top" ToolTip="查看知识点与解析" Visibility="Collapsed"><TextBlock Text="&#xE8F2;" Style="{StaticResource IconGlyphStyle}" /></Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="28,16" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="AskDeepSeekButton" Content="查看解析" Click="AskDeepSeekButton_Click" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" ToolTip="提交答案后，查看当前题目的解析" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SkipButton" Content="跳过" Click="SkipButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="SubmitButton" Content="提交答案" Click="SubmitButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="HelpSidebar" Grid.Column="2" Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="答题助手" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock Text="当前题目与项目知识库" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" /></StackPanel>
                    <Button Grid.Column="1" Click="CloseHelpSidebar_Click" Style="{StaticResource IconButtonStyle}" Content="×" ToolTip="关闭答题助手" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="已匹配知识点" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="KnowledgeLoadingText" Text="正在查询知识库…" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" />
                    <ItemsControl x:Name="KnowledgeMatchesItemsControl" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="22" MaxHeight="110" Loaded="KnowledgeContentText_Loaded" Tag="{Binding ContentSegments}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <StackPanel x:Name="AskAiBanner" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock Text="结合题目与知识点生成解析。" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,12" />
                        <Button x:Name="AskAiButton" Click="AskAiButton_Click" Content="生成解析" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="AiAnswerPanel" Margin="0,24,0,0" Visibility="Collapsed">
                        <TextBlock Text="题目解析" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="AiAnswerText" FontSize="14" LineHeight="24" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
