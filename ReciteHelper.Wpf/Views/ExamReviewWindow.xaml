<Window
    x:Class="ReciteHelper.Wpf.Views.ExamReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ReciteHelper.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReciteHelper.Wpf"
    xmlns:controls="clr-namespace:ReciteHelper.Wpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="考试答案回顾"
    Width="1120"
    Height="760"
    Style="{StaticResource AppWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <c:BooleanToResultConverter x:Key="BooleanToResultConverter" />
        <c:BooleanToColorConverter x:Key="BooleanToColorConverter" />

        <Style x:Key="QuestionItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E9ECEF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style
            x:Key="CorrectAnswerStyle"
            BasedOn="{StaticResource QuestionItemStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
        </Style>

        <Style
            x:Key="WrongAnswerStyle"
            BasedOn="{StaticResource QuestionItemStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="40,24"
            Background="White"
            BorderBrush="{DynamicResource ArcBorder}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock
                        Style="{StaticResource TitleTextStyle}"
                        Text="考试答案回顾" />
                    <TextBlock
                        x:Name="ExamInfoText"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource ArcTextSecondary}"
                        Text="模拟考试 - 答题详情" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="ScoreSummaryText"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource ArcForeground}"
                        Text="得分：0/0" />
                    <Button
                        Click="CloseButton_Click"
                        Content="关闭"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="40,8"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ReviewItemsControl" MaxWidth="880">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{Binding ItemStyle}">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource ArcForeground}"
                                        Text="{Binding QuestionNumber, StringFormat='第{0}题'}" />
                                    <Border
                                        Margin="10,0,0,0"
                                        Padding="8,2"
                                        Background="{Binding IsCorrect, Converter={StaticResource BooleanToColorConverter}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            Text="{Binding IsCorrect, Converter={StaticResource BooleanToResultConverter}}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,0,0,8"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource ArcTextSecondary}"
                                        Text="题目：" />
                                    <TextBlock
                                        Style="{StaticResource ReadingTextStyle}"
                                        Foreground="{DynamicResource ArcForeground}"
                                        Text="{Binding QuestionContent}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Grid.Row="2"
                                    Margin="0,0,0,4"
                                    Padding="12"
                                    Background="{DynamicResource ArcSurfaceMuted}"
                                    CornerRadius="{DynamicResource ArcRadiusControl}">
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource ArcTextSecondary}"
                                            Text="您的答案" />
                                        <controls:AiAnnotatedAnswer
                                            Margin="0,5,0,0"
                                            FontSize="17"
                                            Foreground="{DynamicResource ArcForeground}"
                                            LineHeight="24"
                                            FallbackText="{Binding UserAnswer}"
                                            Assessment="{Binding AiAssessment}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="3" Margin="12,10,12,0">
                                    <controls:AnswerHistoryTimeline Question="{Binding HistorySource}" />
                                    <controls:SubquestionResults Assessment="{Binding AiAssessment}" Margin="0,12,0,4" />
                                </StackPanel>

                                <Border
                                    Grid.Row="4"
                                    Margin="0,8,0,4"
                                    Padding="12"
                                    Background="Transparent"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource ArcTextSecondary}"
                                            Text="正确答案" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Style="{StaticResource ReadingTextStyle}"
                                            Foreground="{DynamicResource ArcForeground}"
                                            LineHeight="24"
                                            Text="{Binding CorrectAnswer}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    Grid.Row="5"
                                    Margin="0,8,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding HasExplanation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource ArcTextSecondary}"
                                        Text="解析：" />
                                    <TextBlock
                                        Style="{StaticResource ReadingTextStyle}"
                                        Foreground="{DynamicResource ArcTextSecondary}"
                                        LineHeight="24"
                                        Text="{Binding Explanation}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="40,24"
            Background="{DynamicResource ArcSurface}"
            BorderBrush="{DynamicResource ArcBorder}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="总题数：" />
                        <TextBlock
                            x:Name="TotalQuestionsText"
                            Margin="5,0,0,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource ArcForeground}"
                            Text="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="答对：" />
                        <TextBlock
                            x:Name="CorrectCountText"
                            Margin="5,0,0,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#28A745"
                            Text="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="答错：" />
                        <TextBlock
                            x:Name="WrongCountText"
                            Margin="5,0,0,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#DC3545"
                            Text="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="正确率：" />
                        <TextBlock
                            x:Name="AccuracyText"
                            Margin="5,0,0,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource ArcForeground}"
                            Text="0%" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,20,0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ImportWrongQuestionsButton"
                        Margin="0,0,12,0"
                        Click="ImportWrongQuestionsButton_Click"
                        Content="导入错题"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        Click="ExportReportButton_Click"
                        Content="导出报告"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Background="Transparent"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Click="CloseButton_Click"
                    Content="返回"
                    Foreground="{DynamicResource ArcTextSecondary}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
