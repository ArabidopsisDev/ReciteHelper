<UserControl x:Class="ReciteHelper.Wpf.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,1,0" Padding="12,24,12,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Button Click="CloseButton_Click" Content="‹  所有项目" HorizontalContentAlignment="Left" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,24" />
                    <TextBlock Text="学习" Style="{StaticResource SidebarLabelStyle}" />
                    <Border Background="{DynamicResource ArcAccentSubtle}" CornerRadius="{DynamicResource ArcRadiusNavigation}" Padding="12,8" Margin="0,2">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ArcGridIcon}" Style="{StaticResource ArcLineIcon}" /><TextBlock Text="章节与聚类" FontSize="{StaticResource ArcFontControl}" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Button x:Name="SimulateButton" Click="SimulateButton_Click" Content="模拟考试" Style="{StaticResource SidebarButtonStyle}" />
                    <Button x:Name="KnowledgeButton" Click="KnowledgeButton_Click" Content="学习知识点" Style="{StaticResource SidebarButtonStyle}" />
                    <TextBlock Text="项目管理" Style="{StaticResource SidebarLabelStyle}" Margin="16,28,0,8" />
                    <Button x:Name="ManageRuleQuestionsButton" Click="ManageRuleQuestions_Click" Content="管理大类与出题" Style="{StaticResource SidebarButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="ExportButton" Click="ExportButton_Click" Content="导入与导出" Style="{StaticResource SidebarButtonStyle}">
                        <Button.ContextMenu><ContextMenu x:Name="FunctionMenu">
                            <MenuItem Click="AddQuestionSourceMenuItem_Click" Header="增加题目来源" />
                            <MenuItem Click="ImportExamMenuItem_Click" Header="导入试卷（PDF/TXT/HTML/MHTML）" />
                            <MenuItem Click="ExportMenuItem_Click" Header="导出" />
                            <MenuItem Click="ReviewMenuItem_Click" Header="智能复习" />
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="16,0"><TextBlock Text="本地项目" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="LastAccessedText" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="36,28,36,24" MaxWidth="880">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24"><TextBlock x:Name="ProjectNameText" Style="{StaticResource TitleTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ProjectPathText" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="章节与聚类" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock x:Name="ChapterStatsText" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
                <Button x:Name="SmartReviewButton" Grid.Column="1" Content="开始智能复习" Click="ReviewMenuItem_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" ToolTip="从项目所有聚类中安排复习题目" />
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="140" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="1" Text="题目" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="2" Text="掌握程度" Style="{StaticResource CaptionTextStyle}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChaptersItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                    <Button Click="ChapterButton_Click" Tag="{Binding}" Style="{StaticResource WorkspaceRowStyle}" Padding="16,12" FontSize="{StaticResource ArcFontBody}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="140" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Chapter.Name}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1" Text="{Binding QuestionCount, StringFormat={}{0} 道}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ArcTextSecondary}" />
                            <Grid Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding MasteryLevel, StringFormat={}{0:F0}%}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                <ProgressBar Grid.Row="1" Style="{StaticResource ArcSlimProgress}" Minimum="0" Maximum="100" Value="{Binding MasteryLevel}" />
                            </Grid>
                            <Path Grid.Column="3" Data="{StaticResource ArcChevronIcon}" Style="{StaticResource ArcLineIcon}" Width="7" Height="12" Margin="0,0,4,0" HorizontalAlignment="Right" />
                        </Grid>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyStatePanel" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="暂无章节" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock Text="通过左侧项目管理添加题目来源。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        </Grid>
    </Grid>
</UserControl>
