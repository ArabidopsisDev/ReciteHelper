<Window x:Class="ReciteHelper.Wpf.Views.PiOAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号授权与模型选择" Width="800" Height="740" MinWidth="700" MinHeight="620"
        Background="#F5F7FA" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="使用已有模型账号" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Margin="0,8,0,16" Text="选择服务并在浏览器中授权，再选择用于资料解析、出题和错题辅助的模型。"
                       Foreground="#64748B" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="模型服务" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ProviderBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="ProviderBox_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="LoginButton" Content="登录 / 重新授权" Click="LoginButton_Click"
                            Background="#007ACC" BorderBrush="#007ACC" Foreground="White" />
                    <Button x:Name="LogoutButton" Content="退出此账号" Click="LogoutButton_Click" />
                    <Button x:Name="CancelOperationButton" Content="取消操作" IsEnabled="False" Click="CancelOperationButton_Click" />
                </StackPanel>
                <TextBlock Text="聊天模型" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ModelBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="ModelBox_SelectionChanged" />
                <TextBlock Margin="0,6,0,0" Foreground="#64748B" Text="模型能否使用取决于账号权限与服务配额。" />
                <StackPanel x:Name="AuthPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="AuthInstructions" TextWrapping="Wrap" Foreground="#334155" />
                    <TextBox x:Name="AuthUrlBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button HorizontalAlignment="Left" Content="打开授权页面" Margin="0,8,0,0" Click="OpenAuthPage_Click" />
                </StackPanel>
                <TextBox x:Name="InfoBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Visibility="Collapsed" Margin="0,8,0,0" />
                <Border x:Name="PromptPanel" Padding="14" Margin="0,12,0,0" Background="#E0F2FE" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox x:Name="PromptInput" />
                        <PasswordBox x:Name="PromptSecret" Padding="8" MinHeight="34" Visibility="Collapsed" />
                        <ComboBox x:Name="PromptChoices" DisplayMemberPath="Label" SelectedValuePath="Id" Visibility="Collapsed" />
                        <Button Content="提交" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SubmitPrompt_Click" />
                    </StackPanel>
                </Border>
                <TextBlock Text="知识库向量服务（可选）" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="QwenEmbeddingKeyBox" Padding="8" MinHeight="34" />
                <TextBlock Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="可填写 Qwen API Key。未填写时使用现有 OpenRouter Key 或托管向量配置；没有向量服务时仍可生成题目，但无法建立或检索知识库。" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="正在读取可用服务…" Foreground="#64748B" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,12" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                       Text="授权凭据加密保存在当前 Windows 用户的本地应用数据中，过期后自动刷新。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="保存并使用" IsEnabled="False" Click="SaveButton_Click"
                        Background="#007ACC" BorderBrush="#007ACC" Foreground="White" />
                <Button Content="返回" Click="BackButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
