<Window x:Class="ReciteHelper.Wpf.Views.SelectChapterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="章节选择 - ReciteHelper" Width="1060" Height="700" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="28,24" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock x:Name="ProjectNameText" Style="{StaticResource TitleTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ProjectPathText" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                <Button Grid.Column="1" Click="CloseButton_Click" Content="返回项目列表" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="28,16" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="SmartReviewButton" Content="智能复习" Click="ReviewMenuItem_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="从项目所有聚类中安排复习题目" />
                <Button x:Name="SimulateButton" Click="SimulateButton_Click" Content="模拟考试" Margin="0,0,8,0" />
                <Button x:Name="KnowledgeButton" Click="KnowledgeButton_Click" Content="学习知识点" Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Click="ExportButton_Click" Content="功能菜单">
                    <Button.ContextMenu><ContextMenu x:Name="FunctionMenu">
                        <MenuItem Click="AddQuestionSourceMenuItem_Click" Header="增加题目来源" />
                        <MenuItem Click="ImportExamMenuItem_Click" Header="导入试卷（PDF/TXT/HTML/MHTML）" />
                        <MenuItem Click="ExportMenuItem_Click" Header="导出" />
                        <MenuItem Click="GameMenuItem_Click" Header="运行游戏" />
                        <MenuItem Click="ReviewMenuItem_Click" Header="智能复习" />
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="章节与聚类" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock x:Name="ChapterStatsText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1" Padding="16,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="1" Text="题目" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="2" Text="掌握程度" Style="{StaticResource CaptionTextStyle}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChaptersItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
                        <Button Click="ChapterButton_Click" Tag="{Binding}" Style="{StaticResource ListRowButtonStyle}" Padding="16,18">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Chapter.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding QuestionCount, StringFormat={}{0} 道}" VerticalAlignment="Center" Foreground="{DynamicResource ArcTextSecondary}" />
                                <Grid Grid.Column="2" Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding MasteryLevel, StringFormat={}{0:F0}%}" Foreground="{DynamicResource ArcTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                                    <ProgressBar Grid.Row="1" Height="3" Minimum="0" Maximum="100" Value="{Binding MasteryLevel}" Foreground="{DynamicResource ArcAccent}" Background="{DynamicResource ArcBorder}" BorderThickness="0" />
                                </Grid>
                                <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource IconGlyphStyle}" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyStatePanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="暂无章节" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock Text="通过功能菜单增加题目来源或导入试卷。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        </Grid>
        <Border Grid.Row="3" Padding="28,12" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LastAccessedText" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="CurrentTimeText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" /></Grid>
        </Border>
    </Grid>
</Window>
