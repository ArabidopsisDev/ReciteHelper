<Window x:Class="ReciteHelper.Wpf.Views.ResourceCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资源中心" Width="1120" Height="820" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,32"><TextBlock Text="资源中心" Style="{StaticResource TitleTextStyle}" /><TextBlock Text="查找课程复习资源，或分享自己的 ReciteHelper 项目包。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="上传者" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UploaderSearchTextBox" TextChanged="SearchTextBox_TextChanged" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="学校" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SchoolSearchTextBox" TextChanged="SearchTextBox_TextChanged" /></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="科目名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SubjectSearchTextBox" TextChanged="SearchTextBox_TextChanged" /></StackPanel>
            <Button Grid.Column="6" Content="搜索" Click="SearchButton_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" VerticalAlignment="Bottom" />
        </Grid>
        <Expander Grid.Row="2" Header="共享你的项目" Margin="0,0,0,28">
            <StackPanel Margin="0,20,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="上传者" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UploaderTextBox" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="学校" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SchoolTextBox" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="科目名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SubjectTextBox" /></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedUploadFileText" Text="尚未选择 .rhp 文件" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="选择项目包" Click="SelectUploadFileButton_Click" /><Button Content="上传" Click="UploadButton_Click" Margin="8,0,0,0" /></StackPanel>
                </Grid>
            </StackPanel>
        </Expander>
        <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ResultSummaryText" Text="正在加载资源…" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResourceItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,20">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0"><TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" /><TextBlock Text="{Binding UploadedAtText}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="上传者" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding Uploader}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="学校" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding School}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="下载并导入" Click="DownloadButton_Click" Tag="{Binding}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="5" Margin="0,24,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PreviousPageButton" Click="PreviousPageButton_Click" Content="上一页" /><TextBlock x:Name="PageText" Text="第 1 / 1 页" Margin="20,0" FontSize="14" VerticalAlignment="Center" /><Button x:Name="NextPageButton" Click="NextPageButton_Click" Content="下一页" /></StackPanel>
            <TextBlock x:Name="ServerAddressText" Grid.Row="1" Style="{StaticResource CaptionTextStyle}" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</Window>
