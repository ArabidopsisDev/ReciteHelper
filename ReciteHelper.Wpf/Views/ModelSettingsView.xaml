<UserControl x:Class="ReciteHelper.Wpf.Views.ModelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,1,0" Padding="8,28,8,20">
            <StackPanel>
                <TextBlock Text="模型服务" Style="{StaticResource SectionLabelTextStyle}" Margin="16,0,0,20" />
                <ListBox x:Name="SettingsNavigation" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItemStyle}">
                    <ListBoxItem Content="当前模型" Tag="CurrentModelSection" />
                    <ListBoxItem Content="账号授权" Tag="OAuthSection" />
                    <ListBoxItem Content="DeepSeek 与 Qwen" Tag="DeepSeekSection" />
                    <ListBoxItem Content="OpenRouter" Tag="OpenRouterSection" />
                    <ListBoxItem Content="托管服务" Tag="HostedSection" />
                </ListBox>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,28,36,24">
                <Grid x:Name="SettingsPages" MaxWidth="640" VerticalAlignment="Top">
                    <StackPanel x:Name="CurrentModelSection">
                        <TextBlock Text="当前模型" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock x:Name="ModelSelectionHintText" Text="选择用于出题、批改和解析的模型服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,24" />
                        <TextBlock Text="已接入的服务" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ActiveModelBox" DisplayMemberPath="Name" SelectedValuePath="Mode" AutomationProperties.Name="当前使用的模型" />
                        <Button x:Name="UseSelectedModelButton" Content="使用所选模型" Click="UseSelectedModel_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                        <TextBlock Text="题目解析" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
                        <CheckBox x:Name="AutoExplainBox" Click="AutoExplain_Click" Content="打开资料与解析时自动生成解析" />
                    </StackPanel>
                    <StackPanel x:Name="OAuthSection" Visibility="Collapsed">
                        <TextBlock Text="账号授权" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="登录已有模型账号，选择该账号可用的模型。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,24" />
                        <Button Content="管理账号与模型" Click="PiOAuthButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel x:Name="DeepSeekSection" Visibility="Collapsed">
                        <TextBlock Text="DeepSeek 与 Qwen" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="DeepSeek 用于文本生成与批改。建立资料知识库时，另需 Qwen 向量服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,24" />
                        <TextBlock Text="DeepSeek API Key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="DeepSeekKeyBox" AutomationProperties.Name="DeepSeek API Key" />
                        <TextBlock Text="Qwen API Key（建立知识库时需要）" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
                        <PasswordBox x:Name="QwenKeyBox" AutomationProperties.Name="Qwen API Key" />
                        <TextBlock Text="也可设置 DEEPSEEK_API_KEY 和 QWEN_API_KEY 环境变量。" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,20" />
                        <Button Content="保存并使用 DeepSeek" Click="SaveDirectKeysButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel x:Name="OpenRouterSection" Visibility="Collapsed">
                        <TextBlock Text="OpenRouter" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="通过 OpenRouter 接入文本与向量模型。可在高级配置中选择模型。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,24" />
                        <TextBlock Text="OpenRouter API Key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="OpenRouterKeyBox" AutomationProperties.Name="OpenRouter API Key" />
                        <Button Content="保存并使用 OpenRouter" Click="SaveOpenRouterButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="HostedSection" Visibility="Collapsed">
                        <TextBlock Text="托管服务" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="输入激活码，由 ReciteHelper 服务器提供模型服务。" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,24" />
                        <TextBlock Text="激活码" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ActivationCodeTextBox" CharacterCasing="Upper" />
                        <Button x:Name="ActivateButton" Content="验证并激活" Click="ActivateButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Padding="36,12" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText" Text="手动填写的 API Key 保存在本机 Config.xml 中。" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />
                    <Grid Grid.Row="1"><Button Click="OpenConfigButton_Click" Content="高级配置" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" /><Button Click="ExitButton_Click" Content="完成" HorizontalAlignment="Right" MinWidth="88" /></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
