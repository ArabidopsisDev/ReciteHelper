<UserControl x:Class="ReciteHelper.Wpf.Views.ProjectNotesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ArcSurfaceMuted}" Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBox x:Name="NotesTextBox" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="{DynamicResource ArcReadingFont}"
                 AutomationProperties.Name="项目笔记" />
        <TextBlock x:Name="SaveStatus" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="自动保存"
                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
