<UserControl x:Class="ReciteHelper.Wpf.Views.QuizView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReciteHelper.Wpf.Controls"
        Background="{DynamicResource ReadingSurface}">
    <UserControl.Resources>
        <DataTemplate x:Key="AnswerCardItem">
            <Button Click="SwitchButton_Click" CommandParameter="{Binding Number}" Content="{Binding Number}" Style="{Binding StatusStyle}" />
        </DataTemplate>
        <SolidColorBrush x:Key="ArchivedAnswerBrush" Color="#215A9D" />
        <Style x:Key="ArchivedAnswerStyle" TargetType="Button" BasedOn="{StaticResource AnswerCardButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ArchivedAnswerBrush}" />
            <Setter Property="Background" Value="#E9F2FF" />
            <Setter Property="BorderBrush" Value="{StaticResource ArchivedAnswerBrush}" />
            <Setter Property="ToolTip" Value="已归档" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDEBFF" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#CFE2FE" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="PracticeLayout">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="AnswerCardColumn" Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Name="PhonkImage" Grid.ColumnSpan="2" Width="256" Height="256" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1000" IsHitTestVisible="False">
            <Image.RenderTransform><TranslateTransform x:Name="ImageTranslate" X="0" Y="0" /></Image.RenderTransform>
        </Image>
        <MediaElement Name="PhonkPlayer" Width="0" Height="0" LoadedBehavior="Manual" UnloadedBehavior="Manual" />
        <Border x:Name="AnswerCard" Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="答题卡" Style="{StaticResource SectionLabelTextStyle}" Margin="18,24,18,16" />
                <ScrollViewer Grid.Row="1" Padding="12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AnswerCardItemsControl" ItemTemplate="{StaticResource AnswerCardItem}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="ManageRuleQuestionsButton" Grid.Row="2" Click="ManageRuleQuestions_Click" Content="管理大类与出题" Style="{StaticResource SmallButtonStyle}" Margin="16,12" Visibility="Collapsed" />
                <Border Grid.Row="3" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="16,12"><TextBlock x:Name="StatsTextBlock" Style="{StaticResource CaptionTextStyle}" /></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="NavigationBorder" Padding="28,12" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="NavigationActions" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="ClearButton" Click="ClearButton_Click" Content="清空记录" Style="{StaticResource SubtleButtonStyle}" MinHeight="{StaticResource ArcControlSmall}" Margin="0,0,8,0" />
                        <Button x:Name="PrevButton" Click="PrevButton_Click" Content="上一题" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0" />
                        <Button x:Name="NextButton" Click="NextButton_Click" Content="下一题" Style="{StaticResource SmallButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CompactCardButton" Content="答题卡" Click="CompactCard_Click" Style="{StaticResource SubtleButtonStyle}"
                                MinHeight="27" Margin="0,0,8,0" Visibility="Collapsed" />
                        <TextBlock x:Name="QuestionPosition" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="QuestionAnswerScroll" Grid.Row="1" Background="{DynamicResource ReadingSurface}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                <StackPanel MaxWidth="760">
                    <Border x:Name="ArchiveBanner" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,9" Margin="0,0,0,15" Visibility="Collapsed">
                        <WrapPanel>
                            <TextBlock x:Name="ArchiveSummary" Text="已归档" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Click="RestoreCurrent_Click" Content="取消归档" Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0" />
                            <Button x:Name="RestoreAllButton" Click="RestoreAll_Click" Content="取消本页全部归档" Style="{StaticResource SubtleButtonStyle}" />
                        </WrapPanel>
                    </Border>
                    <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="FacetContextText" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" Foreground="{DynamicResource ArcAccent}" Visibility="Collapsed" />
                        <TextBlock x:Name="QuestionTextBlock" Grid.Row="1" Style="{StaticResource QuestionTextStyle}" />
                        <Label Name="QDisplayLabel" Grid.Row="2" Padding="0" Margin="0,6,0,0" FontSize="{StaticResource ArcFontCaption}" Foreground="{DynamicResource ArcTextMuted}"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Label.ContentTemplate></Label>
                    </Grid>
                    <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AnswerPromptText" Text="请输入答案：" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <TextBox x:Name="AnswerTextBox" MinHeight="160" FontFamily="{DynamicResource ArcReadingFont}" FontWeight="Normal" Style="{StaticResource QuizTextBoxStyle}" />
                            <controls:MultipartAnswerEditor x:Name="MultipartAnswers" Visibility="Collapsed" />
                            <Border x:Name="InlineAnswerFeedbackBorder" MaxHeight="320" Padding="14,4,0,4" BorderBrush="{DynamicResource ArcBorderStrong}" BorderThickness="2,0,0,0" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><controls:AiAnnotatedAnswer x:Name="InlineAnswerFeedback" /></ScrollViewer>
                            </Border>
                            <ItemsControl x:Name="FillBlankAnswersItemsControl" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,20,12" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number, StringFormat=第{0}空}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ArcTextSecondary}" />
                                    <TextBox Width="190" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="ChoiceOptionsItemsControl" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton Loaded="ChoiceOption_Loaded" Checked="ChoiceOption_Checked" Content="{Binding DisplayText}" GroupName="{Binding ChoiceGroupName, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="{Binding Id}" />
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <StackPanel x:Name="TrueFalseOptionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <RadioButton x:Name="TrueOptionRadioButton" Margin="0,0,16,0" Checked="TrueFalseOption_Checked" Content="正确" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="正确" />
                                <RadioButton x:Name="FalseOptionRadioButton" Checked="TrueFalseOption_Checked" Content="错误" Style="{StaticResource ChoiceOptionRadioStyle}" Tag="错误" />
                            </StackPanel>
                            <controls:AnswerHistoryTimeline x:Name="AnswerHistory" Margin="0,18,0,0" />
                            <controls:SubquestionResults x:Name="PartResults" Margin="0,20,0,8" />
                            <Expander x:Name="AiReferenceExpander" Header="查看参考答案" Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource ArcTextSecondary}" Visibility="Collapsed">
                                <TextBlock x:Name="AiReferenceText" Margin="0,12,0,0" Style="{StaticResource ReadingTextStyle}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ResultArea" Margin="0,28,0,0" Padding="20" CornerRadius="{DynamicResource ArcRadiusControl}" BorderThickness="1" Visibility="Collapsed">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="ResultTitleText" FontWeight="Medium" Margin="0,0,0,12" />
                                <TextBlock Text="您的答案" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="UserAnswerText" Style="{StaticResource ReadingTextStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="参考答案" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="CorrectAnswerText" Style="{StaticResource ReadingTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="ActionsBorder" Grid.Row="2" Padding="28,12" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="HelpButton" Content="资料与解析" Click="HelpButton_Click" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" />
                        <Button x:Name="OpenNotesButton" Content="笔记" Click="OpenNotesButton_Click"
                                Style="{StaticResource SubtleButtonStyle}" ToolTip="打开项目笔记" />
                    </StackPanel>
                    <StackPanel x:Name="SubmissionActions" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="SkipButton" Content="跳过" Click="SkipButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="SubmitButton" Content="提交答案" Click="SubmitButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        <Popup x:Name="CompactCardPopup" PlacementTarget="{Binding ElementName=CompactCardButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="254" Padding="10" Background="{DynamicResource ArcSurface}" BorderBrush="{DynamicResource ArcBorderStrong}" BorderThickness="1" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CompactManageButton" DockPanel.Dock="Bottom" Click="ManageRuleQuestions_Click" Content="管理大类与出题"
                            Style="{StaticResource SmallButtonStyle}" Margin="4,7,4,0" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CompactCardItems" ItemTemplate="{StaticResource AnswerCardItem}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
        <TextBlock x:Name="PracticeEmptyText" Text="本轮题目已更新。可关闭标签页后重新开始复习。"
                   Style="{StaticResource SubtitleTextStyle}" Margin="24" VerticalAlignment="Center"
                   HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
        <controls:QuickReviewCard x:Name="GradingReview" />
    </Grid>
</UserControl>
