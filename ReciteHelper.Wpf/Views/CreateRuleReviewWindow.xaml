<Window x:Class="ReciteHelper.Wpf.Views.CreateRuleReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建规则化复习项目" Width="1160" Height="880" MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="32,24,32,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="创建规则化复习项目" Style="{StaticResource TitleTextStyle}" />
                <TextBlock x:Name="PageDescriptionText" Margin="0,6,0,0" Text="手动设定复习范围，结合课程资料生成简答题。" Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="WorkflowText" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0"
                       Text="建立大类 → 预览题目 → 完成出题" Style="{StaticResource CaptionTextStyle}" />
        </Grid>
        <Border x:Name="ProjectDetailsSection" Grid.Row="1" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1" Padding="32,0,32,20">
            <Grid x:Name="ProjectFields">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="项目名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameBox" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="保存目录" Style="{StaticResource FieldLabel}" />
                    <DockPanel><Button x:Name="ChooseFolderButton" DockPanel.Dock="Right" Content="选择目录…" Click="ChooseFolder_Click" Margin="8,0,0,0" /><TextBox x:Name="FolderBox" IsReadOnly="True" /></DockPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ArcSurfaceMuted}" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="20,24,16,16"><TextBlock Text="聚类大类" Style="{StaticResource SectionLabelTextStyle}" /><TextBlock x:Name="CategoryListHint" Margin="0,6,0,0" Text="按列表顺序依次预览和出题。" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                    <ListBox x:Name="CategoryList" Grid.Row="1" Margin="8,0" BorderThickness="0" Background="Transparent" Padding="0"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number, StringFormat={}{0:00}}" Foreground="{DynamicResource ArcTextMuted}" Margin="0,1,0,0" FontSize="{StaticResource ArcFontCaption}" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" /></StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="AddCategoryButton" Content="增加大类" Click="AddCategory_Click" Style="{StaticResource SmallButtonStyle}" />
                        <Button x:Name="RemoveCategoryButton" Grid.Column="1" Content="删除" Click="RemoveCategory_Click" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
            <ScrollViewer x:Name="RequirementsScroll" Grid.Column="1" Padding="32,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="760" VerticalAlignment="Top">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ScopeTitle" Text="填写大类的出题要求" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,20" />
                    <StackPanel Grid.Row="1" Margin="0,0,0,20"><TextBlock Text="大类名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CategoryNameBox" TextChanged="CategoryNameBox_TextChanged" /></StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="考查对象与内容" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="RequirementsHint" Text="列出全部考查对象，逐项说明需要回答的内容和详细程度。AI 根据这些要求安排题目数量。" Style="{StaticResource SubtitleTextStyle}" />
                    </StackPanel>
                    <TextBox x:Name="PromptBox" Grid.Row="3" Height="124" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12" TextChanged="PromptBox_TextChanged" />
                    <StackPanel x:Name="MaterialControls" Grid.Row="4" Margin="0,20,0,0">
                        <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
                        <TextBlock Text="本类复习资料" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="可添加讲义、课件或笔记。提供资料后，AI 按资料中的核心要点出题和批改。" Style="{StaticResource SubtitleTextStyle}" />
                        <ItemsControl x:Name="MaterialList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="移除" Tag="{Binding}" Click="RemoveMaterial_Click" Style="{StaticResource SubtleButtonStyle}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Button Content="添加资料…" Click="ImportMaterial_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <Expander Header="粘贴资料内容" Margin="0,10,0,0" Foreground="{DynamicResource ArcTextSecondary}"><StackPanel Margin="0,10,0,0">
                            <TextBox x:Name="PastedMaterialBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                            <Button Content="添加粘贴内容" Click="AddPastedMaterial_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel></Expander>
                        <CheckBox x:Name="NoMaterialCheckBox" Content="本次不提供资料" Margin="0,12,0,0" Checked="NoMaterial_Checked" Unchecked="NoMaterial_Unchecked" />
                    </StackPanel>
                    <StackPanel Grid.Row="5">
                    <Expander x:Name="PreviousScopeExpander" Header="查看已有出题要求" Margin="0,16,0,0" Visibility="Collapsed" Foreground="{DynamicResource ArcTextSecondary}" FontSize="13">
                        <TextBlock x:Name="PreviousRequirementsText" Margin="0,12,16,4" Style="{StaticResource SubtitleTextStyle}" />
                    </Expander>
                    <Expander x:Name="ScopeExample" Header="查看植物病理学示例" Margin="0,16,0,0" Foreground="{DynamicResource ArcTextSecondary}" FontSize="13">
                        <TextBlock Margin="0,12,0,4" Padding="0,0,16,0" Style="{StaticResource SubtitleTextStyle}"
                                   Text="列出本类需要考查的所有病原体名称，再分别说明要考查形态特征、寄主、传播途径、致病机制或防治措施中的哪些内容。例如：考查甲、乙、丙三种病原体；每种均需说明寄主和传播途径；甲还需说明致病机制，乙和丙需展开农业防治与药剂防治的具体措施。" />
                    </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="StatusText" Text="为每个大类填写要求并选择资料后，生成首类预览。" Style="{StaticResource SubtitleTextStyle}" />
                    <ProgressBar x:Name="GenerationProgress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource ArcAccent}" Background="{DynamicResource ArcAccentSubtle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DiscardBatchButton" Content="取消本次出题" Click="DiscardBatch_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button Content="关闭" Click="Close_Click" Margin="0,0,8,0" />
                    <Button x:Name="GenerateButton" Content="生成首类预览" Click="Generate_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
