<Window x:Class="ReciteHelper.Wpf.Views.ClearReviewRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清空答题记录" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="28,24">
        <TextBlock Text="清空答题记录" Style="{StaticResource TitleTextStyle}" />
        <TextBlock Text="清空范围" Margin="0,18,0,8" Style="{StaticResource SectionLabelTextStyle}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AllQuestionsOption" GroupName="ClearScope" IsChecked="True" Content="当前页全部题目" Margin="0,0,24,0" />
            <RadioButton x:Name="WrongQuestionsOption" GroupName="ClearScope" Content="所有错题" Margin="0,0,24,0" />
            <RadioButton x:Name="PickQuestionsOption" GroupName="ClearScope" Content="手动勾选" />
        </StackPanel>
        <TextBlock x:Name="ScopeText" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
        <ListBox x:Name="QuestionList" SelectionMode="Multiple" MaxHeight="232" Margin="0,8,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                 Background="{DynamicResource ArcSurface}" BorderBrush="{DynamicResource ArcBorder}"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}" Visibility="Collapsed">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Focusable="False" AutomationProperties.Name="{Binding Stem}"
                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding Stem}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ArcForeground}" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" />
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="清空方式" Margin="0,18,0,8" Style="{StaticResource SectionLabelTextStyle}" />
        <StackPanel Margin="0,0,0,18">
            <RadioButton x:Name="AnswersOnlyOption" GroupName="ClearMode" IsChecked="True" Content="仅清空作答答案" FontWeight="Medium" />
            <TextBlock Text="可以重新作答。保留历次判定、掌握度、EF 和复习安排。" Margin="24,4,0,0"
                       Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel>
            <RadioButton GroupName="ClearMode" Content="完全清空" FontWeight="Medium" />
            <TextBlock Text="删除作答答案和全部答题历史，重置掌握度和复习安排。" Margin="24,4,0,0"
                       Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="确认清空" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
