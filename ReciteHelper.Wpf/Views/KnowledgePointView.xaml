<UserControl
    x:Class="ReciteHelper.Wpf.Views.KnowledgePointView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReciteHelper.Wpf"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ChapterHeaderStyle" TargetType="Border"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style x:Key="ChapterToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ListRowButtonStyle}"><Setter Property="Padding" Value="16,16" /></Style>
        <Style x:Key="KnowledgeItemStyle" TargetType="Border"><Setter Property="Background" Value="Transparent" /></Style>
        <Style x:Key="KnowledgeButtonStyle" TargetType="Button" BasedOn="{StaticResource ListRowButtonStyle}"><Setter Property="Padding" Value="24,14,16,14" /></Style>
        <Style x:Key="MasteredCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{DynamicResource ArcSurfaceMuted}"
            BorderBrush="{DynamicResource ArcBorder}"
            BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border
                    Padding="24,32"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ArcBorder}"
                    BorderThickness="0,0,0,1"
                    Grid.Row="0">
                    <TextBlock
                        FontSize="21"
                        FontWeight="Medium"
                        Foreground="{DynamicResource ArcForeground}"
                        Text="知识点列表" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChaptersItemsControl" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5" Style="{StaticResource ChapterHeaderStyle}">
                                    <StackPanel>
                                        <Button
                                            Click="ChapterToggleButton_Click"
                                            Style="{StaticResource ChapterToggleButtonStyle}"
                                            Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock
                                                        FontSize="15" TextWrapping="Wrap"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource ArcForeground}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="5,0,0,0"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource ArcTextSecondary}"
                                                        Text="{Binding Number, StringFormat=' (第{0}章)'}" />
                                                </StackPanel>

                                                <Path
                                                    x:Name="ExpandIcon"
                                                    Grid.Column="1"
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L8,8 L16,0"
                                                    Stretch="Uniform"
                                                    Stroke="#666666"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" CenterX="8" CenterY="4" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Button>

                                        <ItemsControl
                                            x:Name="KnowledgePointsItemsControl"
                                            Margin="0"
                                            ItemsSource="{Binding KnowledgePoints}"
                                            Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource KnowledgeItemStyle}">
                                                        <Button
                                                            Click="KnowledgePointButton_Click"
                                                            Style="{StaticResource KnowledgeButtonStyle}"
                                                            Tag="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource ArcForeground}"
                                                                    Text="{Binding Name}"
                                                                    TextWrapping="Wrap" />

                                                                <CheckBox
                                                                    Grid.Column="1"
                                                                    Click="MasteryCheckBox_Click"
                                                                    IsChecked="{Binding IsMastered}"
                                                                    Style="{StaticResource MasteredCheckBoxStyle}"
                                                                    Tag="{Binding}">
                                                                    <CheckBox.ToolTip>
                                                                        <ToolTip>
                                                                            <TextBlock Text="标记为已掌握" />
                                                                        </ToolTip>
                                                                    </CheckBox.ToolTip>
                                                                </CheckBox>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    x:Name="EmptyStatePanel" Grid.Row="1"
                    Padding="24" Background="{DynamicResource ArcSurfaceMuted}"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="暂无知识点" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource ArcTextMuted}"
                            Text="当前项目还没有添加任何知识点"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="16,0"
            Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="24,32"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ArcBorder}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock
                                x:Name="KnowledgePointTitle"
                                FontSize="28"
                                FontWeight="Medium"
                                Foreground="{DynamicResource ArcForeground}"
                                Text="选择知识点" />
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource ArcTextSecondary}"
                                    Text="掌握状态：" />
                                <TextBlock
                                    x:Name="MasteryStatusText"
                                    Margin="5,0,0,0"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource ArcDanger}"
                                    Text="未掌握" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox
                            x:Name="MasteryCheckBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="DetailMasteryCheckBox_Click"
                            Content="标记为已掌握"
                            FontSize="12" />
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="24,32"
                    VerticalScrollBarVisibility="Auto">
                    <markdig:MarkdownViewer
                        x:Name="MarkdownViewer"
                        Background="Transparent"
                        Markdown="{Binding CurrentMarkdownContent}" />
                </ScrollViewer>

                <Border
                    x:Name="DetailEmptyStatePanel"
                    Grid.Row="1"
                    Padding="40"
                    Background="White"
                    Visibility="Visible">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="{DynamicResource ArcTextSecondary}"
                            Text="选择知识点" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource ArcTextMuted}"
                            Text="请在左侧选择一个知识点查看详情"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
